<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h4>{{name}}</h4>
    <p>{{role}}</p>
    {{#isEqual isOnline true}}
      <p>Онлайн</p>
    {{else}}
      <p>Офлайн</p>
    {{/isEqual}}

    <br /><br />

    {{#each hobbies}}
      <li>{{this}}</li>
    {{/each}}
  </body>
</html>